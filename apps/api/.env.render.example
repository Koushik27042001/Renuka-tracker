# Render Web Service settings for a manual deploy. Replace the empty required values.
NODE_VERSION=22.22.0
NODE_ENV=production
SKIP_INSTALL_DEPS=true
MONGOMS_DISABLE_POSTINSTALL=1
HOST=0.0.0.0
# Render supplies PORT.

# Required. Use a TLS-enabled Atlas connection string with the production database name.
MONGODB_URI=
# Generate a base64url secret with 32 random bytes.
JWT_ACCESS_SECRET=
# Enter the exact HTTPS dashboard origin, without a trailing slash.
ADMIN_ORIGINS=

# Required for evidence uploads. Enter the production Cloudinary credential URL.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=fieldforce/production/evidence

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
OFFLINE_VISITS_ENABLED=false
OFFLINE_EVIDENCE_ENABLED=false
OFFLINE_EVIDENCE_REQUIRES_REVIEW=true

# Optional tuning. Values below match the API defaults.
# MONGODB_CONNECT_TIMEOUT_MS=8000
# JWT_ISSUER=renuka-api
# JWT_AUDIENCE=renuka-clients
# JWT_ACCESS_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_DAYS=30
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# GLOBAL_RATE_LIMIT=300
# LOGIN_RATE_LIMIT=10
# REFRESH_RATE_LIMIT=30
# ATTENDANCE_PREFERRED_ACCURACY=50
# ATTENDANCE_MAX_ACCURACY=100
# ATTENDANCE_MAX_LOCATION_AGE_SECONDS=30
# ATTENDANCE_MAX_SHIFT_HOURS=24
# OFFLINE_EVIDENCE_MAX_DELAY_HOURS=24
# OFFLINE_SYNC_MAX_RETRIES=8

# Optional. Configure proxy trust only for verified proxy IPs or CIDRs.
# TRUSTED_PROXY_CIDRS=
# METRICS_TOKEN=
# GEOCODING_REVERSE_URL=
# GEOCODING_USER_AGENT=
# GEOCODING_API_KEY=

# Optional mobile release metadata. Use approved HTTPS origins for release URLs.
# MOBILE_RELEASE_APPROVED_ORIGINS=
# MOBILE_DOWNLOAD_PAGE_URL=
# ANDROID_APK_URL=
# ANDROID_APK_SHA256=
# ANDROID_RELEASE_DATE=
# ANDROID_LATEST_VERSION=
# ANDROID_MIN_VERSION=
# IOS_INSTALL_URL=
# IOS_LATEST_VERSION=
# IOS_MIN_VERSION=
# SUPPORT_EMAIL=
