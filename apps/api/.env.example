# Local development. Use .env.render.example for manual Render setup.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
EMPLOYEE_WEB_ORIGINS=http://localhost:5174,http://localhost:4174
MONGODB_URI=
MONGODB_CONNECT_TIMEOUT_MS=8000
JWT_ACCESS_SECRET=
JWT_ISSUER=renuka-api
JWT_AUDIENCE=renuka-clients
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info
BUSINESS_TIMEZONE=Asia/Kolkata
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
GLOBAL_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30

# Supply these only to the one-time administrator bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_CODE=SUPERADMIN

# Image storage credentials for the field visit phase.
CLOUDINARY_URL=

ATTENDANCE_PREFERRED_ACCURACY=50
ATTENDANCE_MAX_ACCURACY=100
ATTENDANCE_MAX_LOCATION_AGE_SECONDS=30
ATTENDANCE_MAX_SHIFT_HOURS=20
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fieldforce/evidence
GEOCODING_REVERSE_URL=
GEOCODING_USER_AGENT=
GEOCODING_API_KEY=

OFFLINE_VISITS_ENABLED=true
OFFLINE_EVIDENCE_ENABLED=true
OFFLINE_EVIDENCE_REQUIRES_REVIEW=true
OFFLINE_EVIDENCE_MAX_DELAY_HOURS=24
OFFLINE_SYNC_MAX_RETRIES=8

# Optional private Prometheus access and signed mobile release metadata.
METRICS_TOKEN=
MOBILE_RELEASE_APPROVED_ORIGINS=
MOBILE_DOWNLOAD_PAGE_URL=
ANDROID_APK_URL=
ANDROID_APK_SHA256=
ANDROID_RELEASE_DATE=
ANDROID_LATEST_VERSION=
ANDROID_MIN_VERSION=
IOS_INSTALL_URL=
IOS_LATEST_VERSION=
IOS_MIN_VERSION=
SUPPORT_EMAIL=
